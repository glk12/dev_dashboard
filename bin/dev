#!/usr/bin/env bash
set -euo pipefail

cleanup() {
  if [[ -n "${web_pid:-}" ]]; then
    kill "$web_pid" 2>/dev/null || true
  fi

  if [[ -n "${css_pid:-}" ]]; then
    kill "$css_pid" 2>/dev/null || true
  fi
}

trap cleanup EXIT INT TERM

bin/rails tailwindcss:watch[always] &
css_pid=$!

bin/rails server "$@" &
web_pid=$!

wait -n "$css_pid" "$web_pid"
