<% content_for :title, "My PRs" %>

<section class="space-y-8">
  <div class="page-header">
    <div class="space-y-2">
      <h1 class="page-title">Pull Requests</h1>
    </div>
  </div>

  <% if @kanban_columns.values.flatten.empty? %>
    <section class="empty-state">
      <div class="empty-state__content empty-state__content--with-icon">
        <div class="empty-state__icon">
          <span class="font-display text-xl font-bold">PR</span>
        </div>
        <div class="stack-sm">
          <h2 class="empty-state__title">No open pull requests</h2>
          <p class="page-copy">
            Activate repositories from the repositories page to start syncing pull requests into this dashboard.
          </p>
        </div>
        <%= link_to "Manage repositories", repositories_path, class: "btn-primary" %>
      </div>
    </section>
  <% else %>
    <section class="space-y-4">
      <div class="overflow-x-auto pb-2">
        <div class="kanban-board">
          <% @kanban_columns.each do |column, pull_requests| %>
            <section class="<%= "kanban-column #{pull_request_column_classes(column)}" %>">
              <div class="kanban-column__header">
                <div>
                  <h3 class="kanban-column__title"><%= @kanban.column_title(column) %></h3>
                  <p class="kanban-column__meta"><%= pluralize(pull_requests.count, "open PR") %></p>
                </div>
                <span class="badge-neutral"><%= pull_requests.count %></span>
              </div>

              <div class="space-y-4">
                <% if pull_requests.any? %>
                  <% pull_requests.each do |pull_request| %>
                    <article class="pr-card">
                      <div class="pr-card__status">
                        <% if pull_request[:draft] %>
                          <span class="pr-card__draft">Draft</span>
                        <% end %>
                      </div>

                      <div class="space-y-3">
                        <div>
                          <%= link_to pull_request[:title], pull_request[:url], target: "_blank", rel: "noopener", class: "pr-card__title" %>
                          <p class="pr-card__repo"><%= pull_request[:repository_name] %></p>
                        </div>

                        <div class="pr-branch-list">
                          <span class="pr-branch pr-branch--head"><%= pull_request[:head_ref] %></span>
                          <span>to</span>
                          <span class="pr-branch pr-branch--base"><%= pull_request[:base_ref] %></span>
                        </div>
                      </div>
                    </article>
                  <% end %>
                <% else %>
                  <div class="kanban-empty">
                    <p class="kanban-empty__copy">No PRs in this stage.</p>
                  </div>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</section>
