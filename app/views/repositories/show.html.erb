<% content_for :title, @repository.name %>

<section class="mx-auto max-w-4xl space-y-8">
  <div class="page-header">
    <div class="space-y-3">
      <p class="eyebrow">Repository Detail</p>
      <h1 class="page-title"><%= @repository.name %></h1>
      <p class="page-copy">
        Review connection details and manage whether this repository participates in your pull request dashboard.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Edit repository", edit_repository_path(@repository), class: "btn-primary" %>
      <%= link_to "Back to repositories", repositories_path, class: "btn-secondary" %>
    </div>
  </div>

  <section class="card space-y-6">
    <%= render @repository %>

    <div class="border-t border-slate-200 pt-6">
      <%= button_to "Delete repository", @repository, method: :delete, class: "btn-danger" %>
    </div>
  </section>
</section>
