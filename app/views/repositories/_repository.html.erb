<div id="<%= dom_id repository %>">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="space-y-2">
      <h2 class="font-display text-xl font-semibold tracking-tight text-white"><%= repository.name %></h2>
      <p class="text-sm text-slate-300"><%= repository.full_name %></p>
    </div>

    <% if repository.active? %>
      <span class="badge-success">Active</span>
    <% else %>
      <span class="badge-neutral">Inactive</span>
    <% end %>
  </div>

  <dl class="grid gap-4 border-t border-slate-800 pt-6 sm:grid-cols-3">
    <div class="space-y-1">
      <dt class="text-sm font-medium text-slate-400">Owner</dt>
      <dd class="text-sm font-semibold text-slate-100"><%= repository.owner %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-slate-400">Repository slug</dt>
      <dd class="text-sm font-semibold text-slate-100"><%= repository.repo_name %></dd>
    </div>

    <div class="space-y-1">
      <dt class="text-sm font-medium text-slate-400">Default branch</dt>
      <dd class="inline-flex w-fit rounded-full border border-brand-400/30 bg-brand-500/15 px-3 py-1 text-sm font-semibold text-brand-200"><%= repository.default_branch %></dd>
    </div>
  </dl>
</div>
