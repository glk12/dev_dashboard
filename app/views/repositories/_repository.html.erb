<div id="<%= dom_id repository %>">
  <div>
    <strong>Name:</strong>
    <%= repository.name %>
  </div>

  <div>
    <strong>Owner:</strong>
    <%= repository.owner %>
  </div>

  <div>
    <strong>Repo name:</strong>
    <%= repository.repo_name %>
  </div>

  <div>
    <strong>Default branch:</strong>
    <%= repository.default_branch %>
  </div>

  <div>
    <strong>Active:</strong>
    <%= repository.active %>
  </div>

</div>
