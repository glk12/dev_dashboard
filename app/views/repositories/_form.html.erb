<%= form_with(model: repository) do |form| %>
  <div class="space-y-6">
    <% if repository.errors.any? %>
      <div class="rounded-2xl border border-rose-200 bg-rose-50 p-4">
        <h2 class="text-sm font-semibold text-rose-800">
          <%= pluralize(repository.errors.count, "error") %> prohibited this repository from being saved
        </h2>

        <ul class="mt-3 space-y-2">
          <% repository.errors.each do |error| %>
            <li class="error-text"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="space-y-2">
        <%= form.label :name, class: "input-label" %>
        <%= form.text_field :name, class: "input-field", placeholder: "Platform API" %>
      </div>

      <div class="space-y-2">
        <%= form.label :owner, class: "input-label" %>
        <%= form.text_field :owner, class: "input-field", placeholder: "acme-inc" %>
      </div>

      <div class="space-y-2">
        <%= form.label :repo_name, "Repository slug", class: "input-label" %>
        <%= form.text_field :repo_name, class: "input-field", placeholder: "platform-api" %>
      </div>

      <div class="space-y-2">
        <%= form.label :default_branch, class: "input-label" %>
        <%= form.text_field :default_branch, class: "input-field", placeholder: "main" %>
      </div>
    </div>

    <div class="card-muted flex items-start gap-4">
      <%= form.check_box :active, class: "input-check mt-1" %>
      <div class="space-y-1">
        <%= form.label :active, "Track this repository", class: "input-label" %>
        <p class="help-text">
          Active repositories are included when pull requests are fetched for the dashboard.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit class: "btn-primary" %>
      <%= link_to "Cancel", repositories_path, class: "btn-secondary" %>
    </div>
  </div>
<% end %>
