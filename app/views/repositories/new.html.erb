<% content_for :title, "New repository" %>

<section class="mx-auto max-w-3xl space-y-8">
  <div class="page-header">
    <div class="space-y-3">
      <p class="eyebrow">Add Source</p>
      <h1 class="page-title">New repository</h1>
      <p class="page-copy">
        Connect a GitHub repository so its pull requests can appear in your dashboard workflow.
      </p>
    </div>
  </div>

  <section class="card">
    <%= render "form", repository: @repository %>
  </section>
</section>
