<% content_for :title, "Repositories" %>

<section class="space-y-8">
  <div class="app-panel p-6 sm:p-8">
    <div class="page-header">
      <div class="space-y-3">
        <p class="eyebrow">Repository Settings</p>
        <h1 class="page-title">Repositories</h1>
        <p class="page-copy">
          These are the repositories visible to your current GitHub token. Activate the ones that should feed your dashboard.
        </p>
      </div>
    </div>
  </div>

  <% if @available_repositories.any? %>
    <section id="repositories" class="repo-grid">
      <% @available_repositories.each do |repository_data| %>
        <article class="repo-card">
          <div class="repo-card__header">
            <div class="stack-sm">
              <div class="repo-card__title-row">
                <h2 class="repo-card__title"><%= repository_data[:name] %></h2>
                <span class="badge-neutral">
                  <% if repository_data[:private] %>
                    Private
                  <% else %>
                    Public
                  <% end %>
                </span>
              </div>

              <p class="repo-card__subtitle"><%= repository_data[:full_name] %></p>
            </div>

            <% if repository_data[:active] %>
              <span class="badge-success">Active</span>
            <% else %>
              <span class="badge-neutral">Inactive</span>
            <% end %>
          </div>

          <dl class="repo-metadata">
            <div class="repo-metadata__item">
              <dt class="repo-metadata__label">Owner</dt>
              <dd class="repo-metadata__value"><%= repository_data[:owner] %></dd>
            </div>

            <div class="repo-metadata__item">
              <dt class="repo-metadata__label">Repository slug</dt>
              <dd class="repo-metadata__value"><%= repository_data[:repo_name] %></dd>
            </div>

            <div class="repo-metadata__item">
              <dt class="repo-metadata__label">Default branch</dt>
              <dd class="badge-branch"><%= repository_data[:default_branch] %></dd>
            </div>
          </dl>

          <div class="repo-actions">
            <%= button_to(repository_data[:active] ? "Deactivate" : "Activate",
                          toggle_repositories_path,
                          method: :patch,
                          params: {
                            repository: {
                              name: repository_data[:name],
                              owner: repository_data[:owner],
                              repo_name: repository_data[:repo_name],
                              default_branch: repository_data[:default_branch],
                              active: !repository_data[:active]
                            }
                          },
                          class: repository_data[:active] ? "btn-secondary" : "btn-primary") %>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <div class="empty-state__content">
        <h2 class="empty-state__title">No repositories available</h2>
        <p class="page-copy mx-auto">
          Your current GitHub token does not expose any repositories yet. Update the token permissions or repository selection and try again.
        </p>
        <%= link_to "Manage GitHub token", edit_github_token_path, class: "btn-primary" %>
      </div>
    </section>
  <% end %>
</section>
